# Vorlage für deploy/.env (wird von einrichten.sh automatisch erzeugt). NIE committen.

# Domain der Plattform, DNS-A-Eintrag muss auf die Server-IP zeigen
DOMAIN=agents.ng-customs.de
NGC_BASIS_URL=https://agents.ng-customs.de

# Ein Geheimnis für ALLE Kunden-Tokens (Cockpit, Webhooks, Telefon). Einmal erzeugen, nie ändern:
#   openssl rand -hex 32
# Denselben Wert lokal bzw. in der Claude-Code-Umgebung setzen, damit Links/Tokens übereinstimmen.
NGC_GEHEIMNIS=

# Claude-API
ANTHROPIC_API_KEY=

# Pro Kunde mit eigenem Agenten-Postfach (Namen stehen in kunden/<slug>/agent/config.json → email):
# BEISPIEL_MALERBETRIEB_MAIL_USER=anfrage@malerbetrieb-beispiel.de
# BEISPIEL_MALERBETRIEB_MAIL_PASS=...
