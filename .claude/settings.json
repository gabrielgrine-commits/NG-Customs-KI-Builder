{
  "enabledMcpjsonServers": [
    "vapi",
    "synthflow"
  ],
  "permissions": {
    "allow": [
      "Bash(python scripts/neuer_kunde.py:*)",
      "Bash(python3 scripts/neuer_kunde.py:*)",
      "Bash(python scripts/validate_config.py:*)",
      "Bash(python3 scripts/validate_config.py:*)",
      "Bash(python scripts/run_tests.py:*)",
      "Bash(python3 scripts/run_tests.py:*)",
      "Bash(python -m runtime pruefen:*)",
      "Bash(python3 -m runtime pruefen:*)",
      "WebSearch",
      "WebFetch",
      "Bash(python3 scripts/agent_hinzufuegen.py:*)",
      "Bash(python scripts/agent_hinzufuegen.py:*)",
      "Bash(python3 scripts/vapi_assistent.py:*)",
      "Bash(python3 -m runtime zugang:*)",
      "Bash(python -m runtime zugang:*)",
      "Bash(python3 -m runtime nachricht:*)",
      "Bash(python -m runtime nachricht:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(python3 scripts/vapi_einrichten.py:*)",
      "Bash(python scripts/vapi_einrichten.py:*)",
      "mcp__vapi__vapi_status",
      "mcp__vapi__vapi_nummern",
      "mcp__vapi__vapi_assistenten",
      "mcp__vapi__vapi_assistent",
      "mcp__vapi__vapi_anrufe",
      "mcp__vapi__vapi_anruf",
      "mcp__vapi__vapi_vorschau"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/config_pruefen.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
